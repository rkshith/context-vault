# --- App ---
APP_NAME=rag-ultimate
ENVIRONMENT=local

# --- PostgreSQL (used by both the postgres container and the backend) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Cloud override (Supabase): full URI takes precedence over the parts above.
# DATABASE_URL=postgresql://postgres.xxx:PASSWORD@host:5432/postgres?sslmode=require

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
# Cloud API key (Qdrant Cloud). Empty for local Docker.
# QDRANT_API_KEY=

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRE_MINUTES=1440

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings (FastEmbed, runs locally in the backend) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- Retrieval ---
TOP_K=6
# Minimum cosine similarity for a chunk to count as "relevant".
# bge-small-en baselines: unrelated text ~0.3-0.45, relevant ~0.6+
SCORE_THRESHOLD=0.5

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25
STORAGE_DIR=/app/storage

# --- CORS / URLs ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Google OAuth (optional; leave empty to disable the Google button) ---
GOOGLE_CLIENT_ID=
